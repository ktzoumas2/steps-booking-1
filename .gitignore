# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local agent/tool settings that should not be shared
.claude/settings.local.json

# Environment and secrets — never commit these.
# The email provider credentials (§8.3) and any hosting keys belong here.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/

# Django — the local SQLite database. It holds only seeded, synthetic data
# (§12.2), but it is a build artefact either way and never belongs in the repo.
db.sqlite3
db.sqlite3-journal

# Collected static files, once there is a deployment that collects them.
/staticfiles/
